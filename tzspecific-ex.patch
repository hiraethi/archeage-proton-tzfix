+static void get_tzinfo_for_year( const DYNAMIC_TIME_ZONE_INFORMATION *dynamic, USHORT year,
+                                 TIME_ZONE_INFORMATION *info )
+{
+    if (GetTimeZoneInformationForYear( year, (DYNAMIC_TIME_ZONE_INFORMATION *)dynamic, info )) return;
+    /* unknown key name: fall back to the static rules in the structure */
+    if (dynamic) memcpy( info, dynamic, sizeof(*info) );
+    else RtlQueryTimeZoneInformation( (RTL_TIME_ZONE_INFORMATION *)info );
+}
+
+
+/***********************************************************************
+ *	SystemTimeToTzSpecificLocalTimeEx   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH SystemTimeToTzSpecificLocalTimeEx( const DYNAMIC_TIME_ZONE_INFORMATION *dynamic,
+                                                                 const SYSTEMTIME *system,
+                                                                 SYSTEMTIME *local )
+{
+    TIME_ZONE_INFORMATION info;
+
+    TRACE( "(%p,%p,%p)\n", dynamic, system, local );
+
+    if (!system || !local)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* the rules are selected by local year, which can differ from the UTC year around New Year */
+    get_tzinfo_for_year( dynamic, system->wYear, &info );
+    if (!SystemTimeToTzSpecificLocalTime( &info, system, local )) return FALSE;
+    if (local->wYear == system->wYear) return TRUE;
+    get_tzinfo_for_year( dynamic, local->wYear, &info );
+    return SystemTimeToTzSpecificLocalTime( &info, system, local );
+}
+
+
+/***********************************************************************
+ *	TzSpecificLocalTimeToSystemTimeEx   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH TzSpecificLocalTimeToSystemTimeEx( const DYNAMIC_TIME_ZONE_INFORMATION *dynamic,
+                                                                 const SYSTEMTIME *local,
+                                                                 SYSTEMTIME *system )
+{
+    TIME_ZONE_INFORMATION info;
+
+    TRACE( "(%p,%p,%p)\n", dynamic, local, system );
+
+    if (!local || !system)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    get_tzinfo_for_year( dynamic, local->wYear, &info );
+    return TzSpecificLocalTimeToSystemTime( &info, local, system );
+}
