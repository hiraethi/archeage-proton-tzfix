+static void test_TzSpecificLocalTimeEx(void)
+{
+    /* Egypt had daylight saving time in August 2014 but not in 2013 */
+    static const struct { WORD year, local_hour; } tests[] = { { 2013, 14 }, { 2014, 15 } };
+    DYNAMIC_TIME_ZONE_INFORMATION dyn_tzinfo;
+    SYSTEMTIME utc, local, back;
+    unsigned int i;
+    BOOL ret;
+
+    if (!pSystemTimeToTzSpecificLocalTimeEx || !pTzSpecificLocalTimeToSystemTimeEx)
+    {
+        win_skip("SystemTimeToTzSpecificLocalTimeEx or TzSpecificLocalTimeToSystemTimeEx not available\n");
+        return;
+    }
+
+    memset(&dyn_tzinfo, 0, sizeof(dyn_tzinfo));
+    lstrcpyW(dyn_tzinfo.TimeZoneKeyName, L"Egypt Standard Time");
+    dyn_tzinfo.Bias = -120;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        memset(&utc, 0, sizeof(utc));
+        utc.wYear = tests[i].year;
+        utc.wMonth = 8;
+        utc.wDay = 15;
+        utc.wHour = 12;
+
+        memset(&local, 0xcc, sizeof(local));
+        ret = pSystemTimeToTzSpecificLocalTimeEx(&dyn_tzinfo, &utc, &local);
+        ok(ret, "SystemTimeToTzSpecificLocalTimeEx failed, err %lu\n", GetLastError());
+        if (!ret) continue;
+        ok(local.wHour == tests[i].local_hour, "%u: expected hour %u, got %u\n",
+           tests[i].year, tests[i].local_hour, local.wHour);
+
+        memset(&back, 0xcc, sizeof(back));
+        ret = pTzSpecificLocalTimeToSystemTimeEx(&dyn_tzinfo, &local, &back);
+        ok(ret, "TzSpecificLocalTimeToSystemTimeEx failed, err %lu\n", GetLastError());
+        if (!ret) continue;
+        ok(back.wYear == utc.wYear && back.wMonth == utc.wMonth && back.wDay == utc.wDay && back.wHour == utc.wHour,
+           "%u: round trip gave %u-%u-%u %u:00\n", tests[i].year, back.wYear, back.wMonth, back.wDay, back.wHour);
+    }
+
+    ret = pSystemTimeToTzSpecificLocalTimeEx(NULL, &utc, &local);
+    ok(ret, "SystemTimeToTzSpecificLocalTimeEx with NULL time zone failed, err %lu\n", GetLastError());
+    ret = pTzSpecificLocalTimeToSystemTimeEx(NULL, &local, &back);
+    ok(ret, "TzSpecificLocalTimeToSystemTimeEx with NULL time zone failed, err %lu\n", GetLastError());
+}
+
